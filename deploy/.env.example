# 复制成 deploy/.env 再填值：cp .env.example .env
# ★ 这个 .env 已被 .gitignore 排除，永远不要提交。

# MySQL 业务账号（compose 的 mysql 服务会自动建这个库与用户）
DB_PASSWORD=change-me-policy-db
MYSQL_ROOT_PASSWORD=change-me-root

# Java 与 Python 之间的唯一凭据
INTERNAL_TOKEN=change-me-internal-token

# JWT 签名密钥：HS256 要求 >= 32 字节。生成：openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes

# 演示账号口令（hr_demo / emp_demo）
DEMO_PASSWORD=policy123

# 生成用的 DeepSeek key（与算法仓库 .env 里那个相同；不填则问答会 500 —— 这是刻意的）
DEEPSEEK_API_KEY=sk-xxxx
