#!/usr/bin/env bash
# ============================================================ pre-commit（本仓库唯一真正会拦的东西）
# 只跑"几毫秒到几秒、且不留假象"的检查：CI 只喊，钩子才拦（这条是本仓库反复踩出来的分工）。
#
# 现在只做一件事：**简历上的数字必须与代码一致**。
# 为什么值得拦在提交上：简历是唯一会发给外部、又最容易和代码脱节的文件
# （2026-11-16 一天里就被抓出 3 个过期的数：range(6) / 473 / 16）。
#
# 绕过：git commit --no-verify。但 commit 信息里别写"检查通过了"。
set -uo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$REPO" || exit 1

PY="D:/Python-project/.venv/Scripts/python.exe"
if [ ! -f "$PY" ]; then
    PY="$(command -v python3 || command -v python || true)"
fi
if [ -z "$PY" ] || ! "$PY" -c "import sys" >/dev/null 2>&1; then
    echo "[pre-commit] 找不到可用的 Python —— 本次提交**未做检查**。"
    exit 1
fi

if ! "$PY" scripts/check_resume_numbers.py; then
    echo
    echo "[pre-commit] ★ 简历数字与代码对不上 —— 先改简历（或先改代码），别把过期的数推出去。"
    echo "             要绕过用 git commit --no-verify，但别声称检查过了。"
    exit 1
fi
echo "[pre-commit] 简历数字 OK"
exit 0
