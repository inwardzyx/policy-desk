<?xml version="1.0" encoding="UTF-8"?>
<!--
  policy-desk / apps/api —— Java 业务层（M2：骨架 + 调 Python 内部接口）

  ★ 为什么先不带数据库（MyBatis-Plus / MySQL 留到 M3）：
    M2 的判据只有一条 —— "Java 能用一个内部口令把问题转给 Python 并拿回答案"。
    这一条**不依赖任何表**。先加数据源会让"起不来"和"调不通"两种失败混在一起，
    排查时分不清是配置问题还是契约问题。等这一条绿了再加表，失败面才是一次只多一个。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.policydesk</groupId>
    <artifactId>policy-desk-api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>policy-desk-api</name>
    <description>制度问答台的业务层：用户/权限/审计在这里，检索与生成在 Python 服务里</description>

    <properties>
        <!-- ★ 编译目标是 17（国内 JD 普遍写「JDK 17 优先」），但用本机 JDK 25 跑。
             用 release 而不是 source/target：它同时校验 API 可用性，避免"用 25 的 API 编出 17 的包"。 -->
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 健康检查：/actuator/health 要能显示 Python 依赖的状态，而不是只显示"我自己活着" -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
